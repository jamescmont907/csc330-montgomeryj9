<%- include('partials/nav') %>

<main>
  <section class="hero-section">
    <!-- TODO: Display profile name in <h1> and headline in <h2> -->
        <h1>James Montgomery</h1>
        <h2>jamescmont@gmail.com ♦ montgomeryj9@southernct.edu</h2>
    <!-- TODO: Display profile summary in a paragraph -->
     <p>Hardworking Computer Science undergraduate seeking opportunities in Information Technology or Software Engineering. Skilled in troubleshooting, networking, and systems support, with strong customer service experience and the ability to explain technical solutions clearly.</p>
  </section>

  <section class="strengths-section">
    <h3>Key Strengths</h3>
    <ul class="strengths-list">
         <% keyStrengths.forEach(strength => { %>
            <li><%= strength %></li>
        <% }); %>
      <!-- TODO: Iterate over profile.keyStrengths and output each item as an <li> --> 
    </ul>
    
  </section>

  <section class="contact-section">
    <h3>Get In Touch</h3>
    <!-- TODO: Wrap the form in the .contact-form class -->
    <form class="contact-form" action="#" method="POST">
       <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <button type="submit" class="btn-submit">Send Message</button>
    </form>
  </section>
</main>

<%- include('partials/footer') %>