<%- include('partials/header') %>

<main>
  <h1>My Skills</h1>

  <!-- TODO: Loop through the skills array --> 
   <% skills.forEach(group => { %>
    
    <!-- TODO: Wrap each category in a <section> with the .category-group class -->
    <section class="category-group">
      <!-- TODO: Display category name in an <h3> -->
        <h2><%= group.category %></h2>
      <!-- TODO: Create a <ul> with the .skills-list class -->
      <ul class="skills-list">
        <% group.items.forEach(item => { %>
          <li class="skill-badge"><%= item %></li>
          <% }); %>
      </ul>
    
     </section>

  <% }); %>

</main>

<%- include('partials/footer') %>